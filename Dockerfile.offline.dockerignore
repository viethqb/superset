# Build context of Dockerfile.offline: only what it copies, including the
# built frontend that the main .dockerignore leaves out
*
!superset
!pyproject.toml
!setup.py
!MANIFEST.in
!README.md
!superset-frontend/package.json
!requirements/base.txt
!docker/*.sh
**/__pycache__/
**/*.pyc
# The base image ships compiled translations, sources are not needed
**/*.po
**/*.pot
